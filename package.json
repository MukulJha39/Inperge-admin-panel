{
  "name": "inperge-admin",
  "version": "1.0.0",
  "private": true,
  "description": "Inperge admin panel — internal operational control centre",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "jest",
    "test:integration": "jest --testPathIgnorePatterns=/node_modules/ --testMatch=**/integration.*.test.tsx --testEnvironment=./tests/env/jsdomWithNodeGlobals.js --forceExit",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "lint": "eslint --ext .ts,.tsx src tests",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^4.9.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "tests/**"
        ],
        "rules": {
          "import/first": "off",
          "testing-library/no-node-access": "off",
          "testing-library/prefer-find-by": "off",
          "testing-library/no-container": "off",
          "testing-library/render-result-naming-convention": "off"
        }
      }
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
