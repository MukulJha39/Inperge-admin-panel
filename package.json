    "test:integration": "jest --testPathIgnorePatterns=/node_modules/ --testMatch=**/integration.*.test.tsx --testEnvironment=./tests/env/jsdomWithNodeGlobals.js --forceExit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
